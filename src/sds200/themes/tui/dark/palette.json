{
  "schema_version": 1,
  "name": "default-dark",
  "styles": {
    "text.primary": {"foreground": "#f5f5f5"},
    "text.muted": {"foreground": "#a3a3a3", "dim": true},
    "connection.unknown": {"foreground": "#a3a3a3", "dim": true},
    "connection.connected": {"foreground": "#5fd75f", "bold": true},
    "connection.degraded": {"foreground": "#ffaf00", "bold": true},
    "connection.disconnected": {"foreground": "#ff5f5f", "bold": true},
    "activity.unknown": {"foreground": "#a3a3a3", "dim": true},
    "activity.idle": {"foreground": "#f5f5f5"},
    "activity.scanning": {"foreground": "#5fafff"},
    "activity.receiving": {"foreground": "#5fd7d7", "bold": true},
    "activity.holding": {"foreground": "#d787ff", "bold": true},
    "signal.unknown": {"foreground": "#a3a3a3", "dim": true},
    "signal.none": {"foreground": "#737373", "dim": true},
    "signal.weak": {"foreground": "#ff5f5f"},
    "signal.fair": {"foreground": "#ffaf00"},
    "signal.good": {"foreground": "#afd75f"},
    "signal.strong": {"foreground": "#5fd75f", "bold": true},
    "hold.unknown": {"foreground": "#a3a3a3", "dim": true},
    "hold.none": {"foreground": "#f5f5f5"},
    "hold.active": {"foreground": "#d787ff", "bold": true},
    "availability.unknown": {"foreground": "#a3a3a3", "dim": true},
    "availability.available": {"foreground": "#f5f5f5"},
    "availability.stale": {"foreground": "#ffaf00"},
    "availability.unavailable": {"foreground": "#ff5f5f"},
    "severity.normal": {"foreground": "#f5f5f5"},
    "severity.info": {"foreground": "#5fafff"},
    "severity.warning": {"foreground": "#ffaf00", "bold": true},
    "severity.error": {"foreground": "#ff5f5f", "bold": true},
    "state.muted": {"foreground": "#a3a3a3", "dim": true},
    "state.recording": {"foreground": "#ff5f5f", "bold": true}
  }
}
